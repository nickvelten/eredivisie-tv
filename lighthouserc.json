{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:3106/",
        "http://localhost:3106/stand",
        "http://localhost:3106/club/ajax-amsterdam",
        "http://localhost:3106/eredivisie-op-tv-vandaag"
      ],
      "startServerCommand": "npm run start -- -p 3106",
      "startServerReadyPattern": "Ready in",
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--headless=new --no-sandbox --disable-dev-shm-usage --disable-gpu"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "warn",
          {
            "minScore": 0.9
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 1
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.1
          }
        ]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
